{
    "name": "componenta/interceptor",
    "description": "Attribute-driven method interception for Componenta",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.5.13",
        "componenta/config": "^3.0.0",
        "componenta/di": "^6.0@dev",
        "componenta/reflection": "^3.0",
        "componenta/scope": "^1.0",
        "psr/container": "^2.0"
    },
    "require-dev": {
        "pestphp/pest": "^4.0",
        "phpbench/phpbench": "^1.7"
    },
    "autoload": {
        "psr-4": {
            "Componenta\\Interceptor\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Componenta\\Interceptor\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "extra": {
        "componenta": {
            "config-providers": [
                "Componenta\\Interceptor\\ConfigProvider"
            ]
        },
        "branch-alias": {
            "dev-main": "4.0.x-dev"
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "policy": {
            "abandoned": {
                "ignore": {
                    "doctrine/annotations": {
                        "on-block": false,
                        "reason": "PHPBench 1.x development-only dependency; benchmarks use native attributes."
                    }
                }
            }
        }
    },
    "scripts": {
        "test": "@php vendor/bin/pest",
        "bench": [
            "Composer\\Config::disableProcessTimeout",
            "@php vendor/bin/phpbench run --config=phpbench.json.dist --report=aggregate --report=env"
        ],
        "bench:smoke": "@php vendor/bin/phpbench run --config=phpbench.json.dist --revs=1 --iterations=1 --warmup=0 --report=aggregate"
    },
    "prefer-stable": true
}
